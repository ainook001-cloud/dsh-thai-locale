{
  "name": "dsh-thai-locale",
  "version": "1.0.6",
  "description": "ชุดภาษาไทยสำหรับ DSH Web (ทดสอบกับ 0.2.1-rc.2) — ลงทะเบียนภาษา th (fallback th → zh → en) และคำแปลไทยสำหรับ namespace ของ client ที่มีมาให้; คาดว่าใช้ได้บน DSH Desktop ที่รัน Web UI เดียวกัน แต่ยังไม่ได้ทดสอบติดตั้งจริง",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "dsh": "^0.2.0"
  },
  "files": [
    "lib",
    "locale",
    "plugin-locales",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "tools",
    "market",
    "docs",
    "tests",
    "progress_report.md",
    "TRANSLATION_STATUS.md"
  ],
  "scripts": {
    "check": "node tools/check-translations.mjs",
    "install-locales": "node tools/install-plugin-locales.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
