{
  "name": "dsh-thai-locale",
  "version": "1.4.1",
  "description": "ชุดภาษาไทยสำหรับ DSH Web (ทดสอบกับ 0.2.1-rc.2) — เพิ่มภาษา th และไทยกวนตีน th-roast (fallback th-roast → th → en) ครบ 4,601 คีย์ใน 75 namespace; คำแปลกวนมาจาก tools/roast-source ที่สร้างซ้ำได้; คาดว่าใช้ได้บน DSH Desktop ที่รัน Web UI เดียวกัน แต่ยังไม่ได้ทดสอบติดตั้งจริง",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "locale",
    "plugin-locales",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "tools",
    "market",
    "docs",
    "tests",
    "progress_report.md",
    "TRANSLATION_STATUS.md",
    "VERSIONING.md",
    "TRANSLATION_REVIEW.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "icon.svg",
    "goldfish_review_report.md"
  ],
  "scripts": {
    "check": "node tools/check-translations.mjs",
    "install-locales": "node tools/install-plugin-locales.mjs",
    "test": "node --test tests/*.test.mjs",
    "install-cards": "node tools/install-plugin-cards.mjs",
    "install-ui": "node tools/install-plugin-ui.mjs",
    "roast:build": "node tools/build-roast.mjs",
    "roast:check": "node tools/check-roast.mjs",
    "roast:ref": "node tools/build-roast.mjs --ref"
  },
  "dependencies": {}
}
